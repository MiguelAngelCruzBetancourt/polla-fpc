# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# firebase
.firebase/
*firebase-adminsdk*.json
serviceAccountKey.json
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log

# typescript
*.tsbuildinfo
next-env.d.ts

# next-pwa (generado en cada build, no es código fuente)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker*.js

.vercel
.env*

# services/ (scaffold local de seguridad/negocio/notificaciones/partidos en vivo)
services/**/node_modules
services/**/dist
!**/.env.local.example
