# Copia este archivo a .env.local y ajusta si hace falta.
# Nunca apuntar estas variables al proyecto real "pollabetplay" durante desarrollo.

PORT=4002

FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_ADMIN_PROJECT_ID=pollabetplay

# URL local de security-api (debe estar corriendo para que business-api
# pueda verificar identidad de usuarios).
SECURITY_API_URL=http://localhost:4001
