# Copia este archivo a .env.local y ajusta si hace falta.
# Nunca apuntar estas variables al proyecto real "pollabetplay" durante desarrollo.

PORT=4004

FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_ADMIN_PROJECT_ID=pollabetplay

# URL local de business-api, para reportar marcadores en vivo.
BUSINESS_API_URL=http://localhost:4002

# API-Football (API-Sports) — recomendado por cobertura de Liga BetPlay/Dimayor.
# Plan gratuito: https://www.api-football.com/
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=reemplaza-con-tu-api-key

# Cada cuánto se hace polling a la API externa (ms). 90s es razonable para
# una quiniela — no necesita latencia de segundos.
POLL_INTERVAL_MS=90000
