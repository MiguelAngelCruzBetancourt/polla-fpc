# Copia este archivo a .env.local y ajusta si hace falta.
# Nunca apuntar estas variables al proyecto real "pollabetplay" durante desarrollo.

PORT=4003

FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_ADMIN_PROJECT_ID=pollabetplay

# URL local de security-api (debe estar corriendo para verificar identidad
# al registrar/eliminar dispositivos).
SECURITY_API_URL=http://localhost:4001

# Cada cuánto se drena la outbox de eventos de negocio (outboxEvents en
# Firestore, escrita por business-api). En producción esto se reemplaza por
# un cron del proveedor de contenedores (Railway); en local es un setInterval.
OUTBOX_DRAIN_INTERVAL_MS=15000
