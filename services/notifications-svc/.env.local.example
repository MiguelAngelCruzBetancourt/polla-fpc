# Copia este archivo a .env.local y ajusta si hace falta.
# Nunca apuntar estas variables al proyecto real "pollabetplay" durante desarrollo.

PORT=4003

FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_ADMIN_PROJECT_ID=pollabetplay

# URL local de security-api (debe estar corriendo para verificar identidad
# al registrar/eliminar dispositivos).
SECURITY_API_URL=http://localhost:4001

# Cada cuánto se drena la outbox de eventos de negocio (outboxEvents en
# Firestore, escrita por business-api), y cada cuánto se revisan los partidos
# próximos a iniciar para recordatorios de pronóstico y aviso de
# disponibilidad. Solo se usan si USE_EXTERNAL_SCHEDULER no está en "true"
# (ver más abajo) — en producción esto se reemplaza por un cron externo
# (GitHub Actions) que llama a los endpoints /internal/outbox/drain-now y
# /internal/match-schedule/check-now; en local sigue siendo un setInterval.
OUTBOX_DRAIN_INTERVAL_MS=15000
MATCH_SCHEDULE_INTERVAL_MS=60000

# En "true" desactiva los setInterval internos de arriba porque un cron
# externo (GitHub Actions en producción) llama directamente a los endpoints
# /internal/outbox/drain-now y /internal/match-schedule/check-now. Déjalo sin
# definir (o en false) en desarrollo local para no cambiar el comportamiento
# actual.
USE_EXTERNAL_SCHEDULER=false

# Secreto compartido que deben enviar los clientes de los endpoints internos
# de cron (header X-Cron-Secret). En local puede ser cualquier string; en
# producción debe coincidir con el secret NOTIFICATIONS_CRON_SECRET configurado
# en el workflow de GitHub Actions (ver .github/workflows/notifications-cron.yml).
CRON_SECRET=dev-only-change-me
