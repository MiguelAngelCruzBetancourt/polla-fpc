# Copia este archivo a .env.local y ajusta si hace falta.
# Nunca apuntar estas variables al proyecto real "pollabetplay" durante desarrollo.

PORT=4001

# Firebase Emulator Suite (mismo mecanismo que ya usa el proyecto raíz vía
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_ADMIN_PROJECT_ID=pollabetplay

# Secreto compartido para firmar/verificar el JWT interno entre servicios.
# En local puede ser cualquier string; en producción debe ser un secreto real
# compartido de forma segura entre security-api, business-api, notifications-svc
# y live-matches-svc.
INTERNAL_AUTH_SECRET=dev-only-change-me
